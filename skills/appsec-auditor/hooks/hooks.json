{
  "description": "appsec-auditor guardrails. Inert unless <project>/.appsec-audit/.active exists.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
