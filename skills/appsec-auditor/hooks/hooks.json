{
  "description": "appsec-auditor guardrails, read tracking, and coverage gate. All inert unless <repo>/.appsec-audit/.active exists. Runs Python 3.12 or newer; on Windows the command is `py` with `-3` as the first argument.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/track.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
