{
  "description": "skill-auditor install gate. Inert unless the environment variable SKILL_AUDITOR_GATE is set to advise or strict. On Windows use command py with -3 as the first argument.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/install-gate.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/hooks/install-gate.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
